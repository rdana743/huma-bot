# Токен бота из кабинета MAX для партнёров
BOT_TOKEN=

# Ваш ID в MAX (узнать: напишите боту /id). Несколько — через запятую.
# Сюда бот присылает новые заявки, и только этим ID доступна команда /stats.
ADMIN_USER_IDS=

# Ссылка на канал Huma Marketing в MAX
CHANNEL_URL=

# Ссылка на оплату гайда (ЮKassa / Prodamus). Пусто — вместо оплаты будет заявка.
PAY_URL_GUIDE_CALLS=

# Кнопка мини-приложения. Пусто — используется имя бота
# (открывается приложение, привязанное к боту в кабинете MAX для партнёров).
MINI_APP=

# ---------- Telegram ----------
TG_BOT_TOKEN=
TG_ADMIN_IDS=
TG_CHANNEL_URL=
MINI_APP_URL=https://rdana743.github.io/huma-miniapp/

# ---------- Аналитика в админке huma.marketing/admin/bot ----------
SITE_URL=https://huma.marketing
# Тот же ключ, что BOT_EVENTS_SECRET в .env сайта
BOT_EVENTS_SECRET=

# Если сервер в России и api.telegram.org недоступен — прокси или зеркало (см. DEPLOY.md)
TG_PROXY=
TG_API_ROOT=

# ---------- HUMA Club: закрытые каналы (DEPLOY.md → «Клуб») ----------
# Telegram: ID канала вида -100…; бот должен быть администратором с правом приглашать и удалять
TG_CLUB_CHAT_ID=
# MAX: ссылка-приглашение в канал и его ID (бот — администратор)
MAX_CLUB_LINK=
MAX_CLUB_CHAT_ID=
